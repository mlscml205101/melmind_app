# MySQL bağlantısı
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=melmind

PORT=4000
JWT_SECRET=buraya-uzun-rastgele-bir-metin-yazin

# İsteğe bağlı: yapay zekâ özellikleri (PDF okuma, tabak fotoğrafı, beslenme koçu)
# Sağlayıcı: gemini veya anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Ana model yoğunsa (503) sırayla denenecek yedek modeller
AI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash

# Anthropic kullanacaksanız:
ANTHROPIC_API_KEY=
# Anahtarı aracı bir satıcıdan aldıysanız onun adresini yazın, Anthropic'ten aldıysanız boş bırakın
ANTHROPIC_BASE_URL=

# Alternatif (öncelikli) adlandırma — aracı satıcı için:
# SCAN_AI_PROVIDER=anthropic
# SCAN_AI_API_KEY=
# SCAN_AI_BASE_URL=https://satici-adresi.com/v1
# SCAN_AI_MODEL=claude-haiku-5-5
